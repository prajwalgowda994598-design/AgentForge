# ─────────────────────────────────────────────────────────────────────────────
# AgentForge – Environment Variables
# Copy this file to .env and fill in the values marked  ← FILL IN
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=AgentForge
APP_VERSION=1.0.0
APP_DEBUG=true
ENVIRONMENT=development
LOCAL_DEV=true

# ── API Server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1
API_PREFIX=/api/v1

# ── Security ───────────────────────────────────────────────────────────────────
SECRET_KEY=local-dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS_STR=http://localhost:3000,http://localhost:5173

# ══════════════════════════════════════════════════════════════════════════════
#  LLM PROVIDER — Choose one of the two sections below
# ══════════════════════════════════════════════════════════════════════════════

# ── OPTION A: OpenRouter (free tier, RECOMMENDED) ─────────────────────────────
#
#  1. Sign up at  https://openrouter.ai
#  2. Go to       https://openrouter.ai/keys
#  3. Click "Create Key" → copy the sk-or-v1-... value
#  4. Paste it below (no credit card required for free models)
#
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=AgentForge

# Free model to use — pick any model with ":free" suffix from:
# https://openrouter.ai/models?q=free
# Run  python agentforge/list_free_models.py  to see currently-active free models.
# Note: google/gemini-2.0-flash-exp:free was removed from OpenRouter in mid-2025.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ── OPTION B: OpenAI directly (comment out OPTION A and uncomment below) ──────
#
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ══════════════════════════════════════════════════════════════════════════════
#  EMBEDDINGS — OpenRouter does NOT do embeddings (use one option below)
# ══════════════════════════════════════════════════════════════════════════════

# ── OPTION 1: Local embeddings — FREE, no API key (RECOMMENDED if no OpenAI) ─
#  First run downloads ~90 MB model.  Install extra: pip install sentence-transformers
#
EMBEDDING_PROVIDER=local

# ── OPTION 2: OpenAI embeddings (comment out OPTION 1 and uncomment below) ────
#  Requires an OpenAI key even when using OpenRouter for chat.
#
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── LLM shared settings ────────────────────────────────────────────────────────
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=4096

# ══════════════════════════════════════════════════════════════════════════════
#  DATABASES (only needed when LOCAL_DEV=false / running Docker)
# ══════════════════════════════════════════════════════════════════════════════

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agentforge
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── FAISS ──────────────────────────────────────────────────────────────────────
FAISS_INDEX_PATH=./vectorstore/faiss_index
FAISS_TOP_K=5
FAISS_DIMENSION=1536

# ── Agent Orchestration ────────────────────────────────────────────────────────
CRITIC_PASS_THRESHOLD=0.7
MAX_RESEARCH_ITERATIONS=3
AGENT_TIMEOUT_SECONDS=120

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false
