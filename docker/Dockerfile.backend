# ─────────────────────────────────────────────────────────────────────────────
# AgentForge – Backend Dockerfile
# Multi-stage build: builder installs deps, runtime is slim.
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: Builder ──────────────────────────────────────────────────────────
FROM python:3.12-slim AS builder

# Install system build tools needed by some packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy and install Python dependencies first (layer caching)
COPY backend/requirements.txt ./requirements.txt
RUN pip install --upgrade pip && \
    pip install --no-cache-dir --prefix=/install -r requirements.txt


# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM python:3.12-slim AS runtime

# Install only runtime system libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash agentforge

# App lives at /app/agentforge so the package import path
# agentforge.backend.main is: /app/agentforge/backend/main.py
# PYTHONPATH must point to /app so "import agentforge" resolves.
WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy application source into /app/agentforge/
COPY backend/         ./agentforge/backend/
COPY sample_data/     ./agentforge/sample_data/
COPY setup.py         ./agentforge/setup.py
COPY pyproject.toml   ./agentforge/pyproject.toml

# Create writable directory for FAISS index
RUN mkdir -p /app/agentforge/vectorstore/faiss_index && \
    chown -R agentforge:agentforge /app

USER agentforge

# PYTHONPATH=/app so "import agentforge.backend.main" works
ENV PYTHONPATH=/app

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

EXPOSE 8000

# Run with 4 Uvicorn workers (Gunicorn can replace this for production)
CMD ["python", "-m", "uvicorn", "agentforge.backend.main:app", \
     "--host", "0.0.0.0", "--port", "8000", "--workers", "4", \
     "--log-level", "info"]
